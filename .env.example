# Copie para .env e preencha os valores locais. Nunca commite o .env.
ENVIRONMENT=local
API_PREFIX=/v1

# Formato: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=
TEST_DATABASE_URL=

# Credenciais do Postgres local, usadas pelo docker-compose.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Segredo do JWT e senha dos usuarios de seed (Loja A/B, buyer e ops).
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
SEED_PASSWORD=
CONVERSATION_INACTIVITY_HOURS=120
