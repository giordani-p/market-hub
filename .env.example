# Copie para .env e preencha os valores locais. Nunca commite o .env.
ENVIRONMENT=local
API_PREFIX=/v1

# Formato: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=
TEST_DATABASE_URL=

# Credenciais do Postgres local, usadas pelo docker-compose.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
