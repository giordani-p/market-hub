# Copie para .env e preencha os valores locais. Nunca commite o .env.
ENVIRONMENT=local
API_PREFIX=/v1
# Origens permitidas para o frontend (separadas por virgula).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Formato: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=
TEST_DATABASE_URL=

# Credenciais do Postgres local, usadas pelo docker-compose.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Segredo do JWT e senha dos usuarios de seed (Loja A/B, buyer e ops).
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
SEED_PASSWORD=
CONVERSATION_INACTIVITY_HOURS=120

# Jobs locais (LocalStack). A API nao precisa destas variaveis.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
JOBS_QUEUE_NAME=market-hub-jobs
JOBS_DLQ_NAME=market-hub-jobs-dlq
JOBS_VISIBILITY_TIMEOUT_SECONDS=60
JOBS_MAX_RECEIVE_COUNT=3
JOBS_WAIT_TIME_SECONDS=10
RECONCILE_PAGE_SIZE=50
JOBS_SCHEDULE_EXPRESSION=rate(15 minutes)

# Destinatario extra do e-mail simulado (high/critical). Vazio = so o Seller.
# O log aparece no stdout do Worker; reinicie o Worker depois de mudar.
NOTIFICATION_EMAIL_EXTRA_TO=
